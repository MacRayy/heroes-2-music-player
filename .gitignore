# dependencies
node_modules/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnp.*

# build output
dist/
build/

# generated audio assets (transcoded from the local game install; do not commit)
public/audio/

# env & local
.env
.env.*
!.env.example

# local editor/agent settings
.claude/settings.local.json
.claude/*.tmp.*

# misc
*.log
.DS_Store

# raw art source (optimized derivative committed instead)
public/art/h2map.png

# extracted UI art + album covers + favicon (regenerate with yarn extract:art)
public/art/ui/
public/art/covers/
public/favicon*.png
public/og.png

# extracted fonts (regenerate with yarn extract:font)
public/fonts/

# Playwright
/test-results/
/playwright-report/
