# Static-site cache rules (Sevalla static hosting reads this file).
# Audio is NOT served from here in prod — it's in the object-storage bucket, whose Cache-Control
# is set per-object at upload; see wiki/integrations/audio-hosting.md. /audio/* below is dev only.

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# The service worker must NEVER be immutable/long-cached: it lives on the client and can't be edge-
# purged, so a fix only reaches stuck clients via the browser's revalidation of this file. Same for
# the manifest so icon/name changes propagate. See wiki/runbooks/pwa-recovery.md.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Game art + fonts: stable filenames (not content-hashed) so NOT immutable — a plain reload must be
# able to pick up a re-extract. But they're effectively frozen game data and `yarn deploy` purges
# the edge on every deploy, so a long TTL is safe and speeds up repeat visits.
/fonts/*
  Cache-Control: public, max-age=31536000

/art/*
  Cache-Control: public, max-age=31536000

/audio/*
  Cache-Control: public, max-age=31536000, immutable
