# Base URL where transcoded MP3 audio is served from.
# Local dev leaves this unset and serves from /audio/ (public/audio/).
# In production point it at your object storage / CDN bucket.
#
# Use a VERSIONED prefix (…/audio/v1/) so the bucket objects can be cached hard
# (Cache-Control: public, max-age=31536000, immutable). If you ever re-transcode a track
# under the same filename, bump the prefix (v1 -> v2) to bust every cache cleanly.
# VITE_AUDIO_BASE_URL=https://<bucket-host>/homm2-audio/v1/
VITE_AUDIO_BASE_URL=

# Cloudflare cache purge — lets `yarn deploy` auto-purge the CDN after each deploy (closes the
# blank-page cache-poisoning window). Copy these into a gitignored .env (NOT here):
#   CLOUDFLARE_PURGE_TOKEN — a scoped token with Zone → Cache Purge (My Profile → API Tokens → Create).
#     NB: intentionally NOT named CLOUDFLARE_API_TOKEN — that is wrangler's own auth var, and a
#     purge-only token there would break `wrangler pages deploy` (deploy uses your `wrangler login`).
#   CLOUDFLARE_ZONE_ID     — the homm2musicplayer.com zone id (dashboard → the domain → Overview, right sidebar).
# Real shell env vars override .env. Without both set, `yarn deploy` just reminds you to purge manually.
CLOUDFLARE_PURGE_TOKEN=
CLOUDFLARE_ZONE_ID=
