# Base URL where transcoded MP3 audio is served from.
# Local dev leaves this unset and serves from /audio/ (public/audio/).
# In production point it at your object storage / CDN bucket.
#
# Use a VERSIONED prefix (…/audio/v1/) so the bucket objects can be cached hard
# (Cache-Control: public, max-age=31536000, immutable). If you ever re-transcode a track
# under the same filename, bump the prefix (v1 -> v2) to bust every cache cleanly.
# VITE_AUDIO_BASE_URL=https://<bucket-host>/homm2-audio/v1/
VITE_AUDIO_BASE_URL=
